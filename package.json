{
  "name": "latex-peek",
  "displayName": "LaTeX Peek",
  "description": "Preview a selected LaTeX formula in VS Code.",
  "version": "0.1.0",
  "publisher": "genturee",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:latexPeek.previewSelectedFormula"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "keybindings": [
      {
        "command": "latexPeek.previewSelectedFormula",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus"
      }
    ],
    "commands": [
      {
        "command": "latexPeek.previewSelectedFormula",
        "title": "LaTeX Peek: Preview Formula at Cursor or Selection"
      }
    ],
    "configuration": {
      "title": "LaTeX Peek",
      "properties": {
        "latexPeek.preview.scale": {
          "type": "number",
          "default": 1,
          "minimum": 0.5,
          "maximum": 2,
          "description": "Scale the formula in the LaTeX Peek preview (1 = 100%)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "test": "npm run compile && node --test ./out/test/*.test.js"
  },
  "dependencies": {
    "katex": "^0.19.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.8.3"
  }
}
